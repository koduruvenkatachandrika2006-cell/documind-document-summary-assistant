{
  "name": "documind",
  "version": "1.0.0",
  "description": "DocuMind - AI-Powered Document Summary Assistant",
  "main": "server/src/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "npx tsx watch server/src/index.ts",
    "dev:client": "npx vite --config client/vite.config.ts",
    "dev": "npx concurrently npm:dev:server npm:dev:client",
    "build:client": "npx vite build --config client/vite.config.ts",
    "build:server": "npx tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "lint": "npx tsc -p server/tsconfig.json --noEmit",
    "test": "npx vitest run"
  },
  "keywords": [
    "ai",
    "ocr",
    "pdf-parser",
    "summarizer",
    "document-ai",
    "tesseract",
    "gemini"
  ],
  "author": "Software Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.395.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
